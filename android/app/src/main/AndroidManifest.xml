<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet + Ads (Unity LevelPlay بيستخدم معرّف الإعلانات كمان) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <!-- ⬇️ أذونات جديدة — بدونها ميزات الشات دي هتفشل صامتة على أندرويد
         حتى لو الكود بتاعها شغال، لأن النظام مش هيسمح للـ WebView يطلبها
         أصلًا من غير ما تكون معلنة هنا. -->

    <!-- الإشعارات الحقيقية (لازم إجباريًا من أندرويد 13 / API 33 فأعلى) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- الكاميرا: لالتقاط صور/فيديو ومكالمات الفيديو (WebRTC) -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- الميكروفون: للرسائل الصوتية والمكالمات الصوتية/الفيديو -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- تم حذف ACCESS_FINE_LOCATION / ACCESS_COARSE_LOCATION
         بعد إزالة ميزة مشاركة الموقع من التطبيق، طبقًا لنموذج أمان البيانات. -->

    <!-- تم حذف READ_MEDIA_IMAGES / READ_MEDIA_VIDEO / READ_EXTERNAL_STORAGE
         لأن اختيار الصور والفيديوهات يتم عبر <input type="file"> داخل الـ WebView،
         وهذا يستخدم أداة الاختيار المضمّنة بالنظام (Photo Picker) تلقائيًا
         بدون الحاجة لهذه الأذونات، طبقًا لسياسة Google Play. -->

    <!-- قفل التطبيق بالبصمة/الوجه -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- File Provider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
