# انسخ هذا الملف إلى .env واملأ القيم (cp .env.example .env)

# إلزامي — من Supabase → Project Settings → API
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"
VITE_SUPABASE_PROJECT_ID="YOUR_PROJECT_ID"

# إلزامي للإنتاج (وخصوصًا داخل تطبيق Capacitor للموبايل) — دومين النشر
# الحقيقي بتاع نسخة الويب، يُستخدم لبناء روابط قابلة للمشاركة (زي روابط
# دعوة الجروبات). بدونها بيرجع تلقائيًا لـ window.location.origin، وده
# مناسب فقط للتطوير المحلي.
VITE_APP_WEB_ORIGIN="https://your-real-domain.example.com"

# اختياري — سيرفر TURN لتحسين نجاح مكالمات WebRTC خلف NAT صارم/شبكات الشركات و4G.
# بدونها، المكالمات تعتمد على STUN المجاني فقط (stun.l.google.com) وتعمل غالبًا
# على الشبكات المنزلية، لكنها قد تفشل في بعض الشبكات المقيَّدة.
# مثال مزوّد: Twilio Network Traversal Service، أو coturn ذاتي الاستضافة.
# مثال قيمة: turn:your-turn-host:3478
VITE_TURN_URL=""
VITE_TURN_USERNAME=""
VITE_TURN_CREDENTIAL=""
